# Copy to .env. Plain text. Any value can reference ${HOST_IP}, ${API_PORT} or ${WEB_PORT}.
NODE_ENV=development

# ── Local address (keep HOST_IP, WEB_PORT and HTTPS the same as in devhub-web/.env) ──
# "localhost", or this machine's LAN IP (see `ipconfig`, e.g. 192.168.1.20) to open the app from
# other devices. localhost keeps working either way.
HOST_IP=localhost
API_PORT=4000
WEB_PORT=3000
# Empty = automatic: HTTPS on for a LAN IP, off for localhost.
HTTPS=

# Postgres and Redis run on this machine, so localhost always works. Switch to ${HOST_IP} only if they
# must be reached by IP (Postgres also needs listen_addresses and pg_hba.conf to allow it).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/devhub
# Upstash Redis: copy both from the Upstash console (database → REST API).
UPSTASH_REDIS_REST_URL=https://<your-db>.upstash.io
UPSTASH_REDIS_REST_TOKEN=

JWT_ACCESS_SECRET=change-me-access-secret-change-me
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECRET=change-me-cookie-secret-change-me

# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DB_ENCRYPTION_KEY=

# Optional. Without SMTP_HOST, emails are logged instead of sent. Local catcher: docker compose mailpit
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=DevHub <no-reply@devhub.local>

# Optional error tracking.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
