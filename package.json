{
  "name": "devhub-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "tsx watch --import ./src/instrument.ts src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --enable-source-maps --import ./dist/src/instrument.js dist/src/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "db:migrate": "tsx node_modules/knex/bin/cli.js migrate:latest --knexfile knexfile.ts",
    "db:rollback": "tsx node_modules/knex/bin/cli.js migrate:rollback --knexfile knexfile.ts",
    "db:seed": "tsx node_modules/knex/bin/cli.js seed:run --knexfile knexfile.ts",
    "db:make": "tsx node_modules/knex/bin/cli.js migrate:make --knexfile knexfile.ts -x ts"
  },
  "dependencies": {
    "@sentry/node": "^11.0.0",
    "@sentry/profiling-node": "^11.0.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "hpp": "^0.2.3",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.3.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "rate-limit-redis": "^6.0.1",
    "socket.io": "^4.8.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/hpp": "^0.2.7",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "argon2@0.45.1": true
  }
}
